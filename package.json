{
  "name": "ha-solaredge-card",
  "version": "0.1.0",
  "description": "Home Assistant Lovelace card for SolarEdge solar + EV monitoring",
  "type": "module",
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "dev": "rollup -c rollup.config.mjs --watch",
    "lint": "eslint src --ext .ts && prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "audit-check": "npm audit --audit-level=high"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "minimatch": "^6.0.4"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "15.3.0",
    "@rollup/plugin-typescript": "12.1.3",
    "@typescript-eslint/eslint-plugin": "8.33.1",
    "@typescript-eslint/parser": "8.33.1",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "lit": "3.3.0",
    "prettier": "3.5.3",
    "rollup": "4.68.2",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "vitest": "5.1.0"
  }
}
